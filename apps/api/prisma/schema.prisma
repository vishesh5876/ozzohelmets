// Helmet Emergency Identity & Product Authentication Platform
// Conventions: UUID (v7) primary keys, snake_case tables/columns, created_at/updated_at everywhere.
// Schema changes go through `prisma migrate dev` → committed migrations → `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum HelmetStatus {
  GENERATED
  PRINTED
  IN_INVENTORY
  SOLD
  ACTIVATED
  ACTIVE
  LOST
  STOLEN
  DAMAGED
  REPLACED
  DEACTIVATED
  RECALLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANUFACTURING
  SUPPORT
  ANALYTICS_VIEWER
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum HelmetModelStatus {
  ACTIVE
  ARCHIVED
}

enum BatchGenerationStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum BatchPrintStatus {
  NOT_PRINTED
  PRINTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OwnershipStatus {
  ACTIVE
  TRANSFERRED
  REVOKED
}

/// How an ownership period began.
enum OwnershipAcquisition {
  ACTIVATION
  TRANSFER
}

enum TransferStatus {
  PENDING
  CLAIMED
  CANCELLED
  EXPIRED
}

enum ReplacementReason {
  DAMAGED
  DEFECTIVE
  ACCIDENT
  SUPPORT_REPLACEMENT
  OTHER
}

enum ActorType {
  SYSTEM
  ADMIN
  OWNER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum ScanType {
  EMERGENCY_PAGE
  VERIFY
  ACTIVATION
}

// ─────────────────────────────── Admin ───────────────────────────────

model AdminUser {
  id           String          @id @default(uuid(7)) @db.Uuid
  name         String          @db.VarChar(120)
  email        String          @unique @db.VarChar(254)
  passwordHash String          @map("password_hash")
  role         AdminRole
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens  AdminRefreshToken[]
  auditLogs      AuditLog[]
  createdBatches HelmetBatch[]
  replacements   HelmetReplacement[]

  @@map("admin_users")
}

/// Opaque refresh tokens, stored as SHA-256 hashes. Rotated on every use; `familyId` groups a
/// rotation chain so reuse of a revoked token revokes the whole family.
model AdminRefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
  @@map("admin_refresh_tokens")
}

// ─────────────────────────────── Customers (Phase 2 schema) ───────────────────────────────

/// Customer account. Identity is established through helmet ownership + password; email and
/// mobile are optional, owner-provided and UNVERIFIED (never used for auth or recovery, hence
/// not unique).
model User {
  id                    String     @id @default(uuid(7)) @db.Uuid
  name                  String?    @db.VarChar(120)
  email                 String?    @db.VarChar(254)
  mobile                String?    @db.VarChar(20)
  passwordHash          String?    @map("password_hash")
  passwordChangedAt     DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Argon2id (peppered) hash of the offline recovery code; the plaintext is shown once.
  recoveryCodeHash      String?    @map("recovery_code_hash")
  recoveryCodeCreatedAt DateTime?  @map("recovery_code_created_at") @db.Timestamptz(3)
  mobileVerified        Boolean    @default(false) @map("mobile_verified")
  emailVerified         Boolean    @default(false) @map("email_verified")
  status                UserStatus @default(ACTIVE)
  lastLoginAt           DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerships          HelmetOwnership[]
  auditLogs           AuditLog[]
  refreshTokens       CustomerRefreshToken[]
  emergencyProfiles   EmergencyProfile[]
  emergencyContacts   EmergencyContact[]
  emergencyVisibility EmergencyVisibility?
  helmetEmergency     HelmetEmergencySetting[]
  transfersFrom       HelmetTransfer[]         @relation("TransferFrom")
  transfersTo         HelmetTransfer[]         @relation("TransferTo")

  @@map("users")
}

/// Customer refresh tokens — same rotation/reuse-detection model as admin tokens.
model CustomerRefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("customer_refresh_tokens")
}

/// Emergency profile owned by a customer. `helmetId` is reserved for future per-helmet
/// overrides (NULL = the customer's default profile; partial unique indexes in SQL).
/// *_ciphertext columns hold AES-256-GCM payloads bound to (profile id, field) via AAD.
model EmergencyProfile {
  id                          String      @id @db.Uuid
  userId                      String      @map("user_id") @db.Uuid
  helmetId                    String?     @map("helmet_id") @db.Uuid
  name                        String?     @db.VarChar(120)
  bloodGroup                  BloodGroup? @map("blood_group")
  gender                      Gender?
  organDonor                  Boolean?    @map("organ_donor")
  dateOfBirthCiphertext       String?     @map("date_of_birth_ciphertext")
  allergiesCiphertext         String?     @map("allergies_ciphertext")
  medicalConditionsCiphertext String?     @map("medical_conditions_ciphertext")
  medicationsCiphertext       String?     @map("medications_ciphertext")
  emergencyNotesCiphertext    String?     @map("emergency_notes_ciphertext")
  photoKey                    String?     @map("photo_key") @db.VarChar(255)
  photoContentType            String?     @map("photo_content_type") @db.VarChar(40)
  photoUpdatedAt              DateTime?   @map("photo_updated_at") @db.Timestamptz(3)
  emergencyProfileEnabled     Boolean     @default(false) @map("emergency_profile_enabled")
  enabledAt                   DateTime?   @map("enabled_at") @db.Timestamptz(3)
  createdAt                   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  helmet Helmet? @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_profiles")
}

model EmergencyContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(120)
  relationship   String   @db.VarChar(60)
  phone          String   @db.VarChar(20)
  alternatePhone String?  @map("alternate_phone") @db.VarChar(20)
  /// 1 = called first. Unique among a user's active contacts (partial index in SQL).
  priority       Int
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("emergency_contacts")
}

/// What the public QR page may show. Everything defaults to hidden.
model EmergencyVisibility {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  showName              Boolean   @default(false) @map("show_name")
  showPhoto             Boolean   @default(false) @map("show_photo")
  showBloodGroup        Boolean   @default(false) @map("show_blood_group")
  showDateOfBirth       Boolean   @default(false) @map("show_date_of_birth")
  showGender            Boolean   @default(false) @map("show_gender")
  showAllergies         Boolean   @default(false) @map("show_allergies")
  showMedicalConditions Boolean   @default(false) @map("show_medical_conditions")
  showMedications       Boolean   @default(false) @map("show_medications")
  showEmergencyNotes    Boolean   @default(false) @map("show_emergency_notes")
  showOrganDonor        Boolean   @default(false) @map("show_organ_donor")
  showEmergencyContacts Boolean   @default(false) @map("show_emergency_contacts")
  /// Set when the owner explicitly reviews and saves their public visibility choices.
  confirmedAt           DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_visibility")
}

// ─────────────────────────────── Catalogue & manufacturing ───────────────────────────────

model HelmetModel {
  id          String            @id @default(uuid(7)) @db.Uuid
  name        String            @db.VarChar(120)
  sku         String            @unique @db.VarChar(64)
  brand       String            @db.VarChar(80)
  description String?           @db.Text
  status      HelmetModelStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  batches HelmetBatch[]
  helmets Helmet[]

  @@index([status])
  @@map("helmet_models")
}

model HelmetBatch {
  id                    String                @id @default(uuid(7)) @db.Uuid
  batchCode             String                @unique @map("batch_code") @db.VarChar(32)
  helmetModelId         String                @map("helmet_model_id") @db.Uuid
  manufacturingDate     DateTime              @map("manufacturing_date") @db.Date
  quantity              Int
  generatedCount        Int                   @default(0) @map("generated_count")
  generationStatus      BatchGenerationStatus @default(PENDING) @map("generation_status")
  generationError       String?               @map("generation_error") @db.VarChar(500)
  generationStartedAt   DateTime?             @map("generation_started_at") @db.Timestamptz(3)
  generationCompletedAt DateTime?             @map("generation_completed_at") @db.Timestamptz(3)
  printStatus           BatchPrintStatus      @default(NOT_PRINTED) @map("print_status")
  printedAt             DateTime?             @map("printed_at") @db.Timestamptz(3)
  notes                 String?               @db.VarChar(1000)
  createdBy             String?               @map("created_by") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmetModel HelmetModel @relation(fields: [helmetModelId], references: [id], onDelete: Restrict)
  creator     AdminUser?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  helmets     Helmet[]

  @@index([helmetModelId])
  @@index([generationStatus])
  @@index([createdAt])
  @@map("helmet_batches")
}

/// One physical helmet. `id` is the internal helmet UUID and never appears in public URLs.
model Helmet {
  id                        String        @id @default(uuid(7)) @db.Uuid
  helmetCode                String        @unique @map("helmet_code") @db.VarChar(16)
  publicToken               String        @unique @map("public_token") @db.VarChar(32)
  activationPinHash         String        @map("activation_pin_hash")
  activationPinUsed         Boolean       @default(false) @map("activation_pin_used")
  activationAttempts        Int           @default(0) @map("activation_attempts")
  /// Progressive lockout after repeated wrong PINs.
  activationLockedUntil     DateTime?     @map("activation_locked_until") @db.Timestamptz(3)
  serialNumber              String        @unique @map("serial_number") @db.VarChar(40)
  helmetModelId             String        @map("helmet_model_id") @db.Uuid
  batchId                   String        @map("batch_id") @db.Uuid
  status                    HelmetStatus  @default(GENERATED)
  /// Operational status (ACTIVATED/ACTIVE) held before entering LOST/STOLEN/DAMAGED, so a
  /// restore returns to the right place. Maintained only by HelmetStatusService.apply.
  previousOperationalStatus HelmetStatus? @map("previous_operational_status")
  activatedAt               DateTime?     @map("activated_at") @db.Timestamptz(3)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmetModel       HelmetModel              @relation(fields: [helmetModelId], references: [id], onDelete: Restrict)
  batch             HelmetBatch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  activationSecret  HelmetActivationSecret?
  ownerships        HelmetOwnership[]
  emergencyProfiles EmergencyProfile[]
  statusHistory     HelmetStatusHistory[]
  scans             HelmetScan[]
  emergencySettings HelmetEmergencySetting[]
  transfers         HelmetTransfer[]
  replacedBy        HelmetReplacement?       @relation("ReplacementOriginal")
  replaces          HelmetReplacement?       @relation("ReplacementNew")

  @@index([status])
  @@index([batchId])
  @@index([helmetModelId])
  @@index([createdAt])
  @@map("helmets")
}

/// Encrypted (AES-256-GCM, PIN_ESCROW_KEY) activation PIN escrow, kept only until labels are
/// printed or the PIN is used. Never holds plaintext. See docs/SECURITY.md.
model HelmetActivationSecret {
  helmetId      String   @id @map("helmet_id") @db.Uuid
  pinCiphertext String   @map("pin_ciphertext") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmet Helmet @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  @@map("helmet_activation_secrets")
}

model HelmetStatusHistory {
  id         String        @id @default(uuid(7)) @db.Uuid
  helmetId   String        @map("helmet_id") @db.Uuid
  fromStatus HelmetStatus? @map("from_status")
  toStatus   HelmetStatus  @map("to_status")
  actorType  ActorType     @map("actor_type")
  actorId    String?       @map("actor_id") @db.Uuid
  reason     String?       @db.VarChar(500)
  /// Machine-readable reason (e.g. TRANSFER, LOST_REPORTED, DAMAGED:ACCIDENT). Never free text.
  reasonCode String?       @map("reason_code") @db.VarChar(60)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  helmet Helmet @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  @@index([helmetId, createdAt])
  @@map("helmet_status_history")
}

/// Ownership history — never overwritten. Exactly one ACTIVE row per helmet (partial unique
/// index added in migration SQL).
model HelmetOwnership {
  id             String               @id @default(uuid(7)) @db.Uuid
  helmetId       String               @map("helmet_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  status         OwnershipStatus      @default(ACTIVE)
  acquiredVia    OwnershipAcquisition @default(ACTIVATION) @map("acquired_via")
  /// Start of the ownership period.
  activatedAt    DateTime             @default(now()) @map("activated_at") @db.Timestamptz(3)
  transferredAt  DateTime?            @map("transferred_at") @db.Timestamptz(3)
  /// End of the period (transfer or admin revocation); NULL while ACTIVE.
  endedAt        DateTime?            @map("ended_at") @db.Timestamptz(3)
  endReason      String?              @map("end_reason") @db.VarChar(60)
  /// Transfer that started (to) or ended (from) this period.
  transferId     String?              @map("transfer_id") @db.Uuid
  endedByAdminId String?              @map("ended_by_admin_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmet Helmet @relation(fields: [helmetId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([helmetId, activatedAt])
  @@index([userId, status])
  @@map("helmet_ownerships")
}

/// Whether a helmet exposes its owner's emergency profile. The profile itself (medical data,
/// contacts, visibility) belongs to the user; this row is per (helmet, owner) so a new owner
/// never inherits the previous owner's switch.
model HelmetEmergencySetting {
  id          String    @id @default(uuid(7)) @db.Uuid
  helmetId    String    @map("helmet_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  enabled     Boolean   @default(false)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmet Helmet @relation(fields: [helmetId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([helmetId, userId])
  @@index([userId])
  @@map("helmet_emergency_settings")
}

/// Ownership transfer offers. Only an HMAC of the transfer code is stored; at most one PENDING
/// row per helmet (partial unique index in SQL). Expiry is computed from `expiresAt`.
model HelmetTransfer {
  id                 String         @id @default(uuid(7)) @db.Uuid
  helmetId           String         @map("helmet_id") @db.Uuid
  fromUserId         String         @map("from_user_id") @db.Uuid
  toUserId           String?        @map("to_user_id") @db.Uuid
  status             TransferStatus @default(PENDING)
  codeHash           String         @map("code_hash") @db.Char(64)
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(3)
  claimedAt          DateTime?      @map("claimed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?        @map("cancel_reason") @db.VarChar(60)
  cancelledByAdminId String?        @map("cancelled_by_admin_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  helmet   Helmet @relation(fields: [helmetId], references: [id], onDelete: Restrict)
  fromUser User   @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User?  @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([helmetId, createdAt])
  @@index([fromUserId])
  @@map("helmet_transfers")
}

/// A physically different helmet that replaces another. Each helmet appears at most once as
/// original and at most once as replacement; cycles are rejected by the domain service.
model HelmetReplacement {
  id                  String            @id @default(uuid(7)) @db.Uuid
  originalHelmetId    String            @unique @map("original_helmet_id") @db.Uuid
  replacementHelmetId String            @unique @map("replacement_helmet_id") @db.Uuid
  reason              ReplacementReason
  notes               String?           @db.VarChar(500)
  createdByAdminId    String?           @map("created_by_admin_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  original    Helmet     @relation("ReplacementOriginal", fields: [originalHelmetId], references: [id], onDelete: Restrict)
  replacement Helmet     @relation("ReplacementNew", fields: [replacementHelmetId], references: [id], onDelete: Restrict)
  createdBy   AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@map("helmet_replacements")
}

// ─────────────────────────────── Telemetry & audit ───────────────────────────────

/// Append-only QR scan log. IPs are stored only as keyed HMAC-SHA256 hashes.
model HelmetScan {
  id          String   @id @default(uuid(7)) @db.Uuid
  helmetId    String   @map("helmet_id") @db.Uuid
  scannedAt   DateTime @default(now()) @map("scanned_at") @db.Timestamptz(3)
  ipHash      String?  @map("ip_hash") @db.Char(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  countryCode String?  @map("country_code") @db.Char(2)
  scanType    ScanType @map("scan_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  helmet Helmet @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  @@index([helmetId, scannedAt])
  @@index([scannedAt])
  @@map("helmet_scans")
}

/// Append-only audit trail for security-relevant operations.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?
  ipHash     String?  @map("ip_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
