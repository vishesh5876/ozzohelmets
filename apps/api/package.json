{
  "name": "@helmet/api",
  "version": "0.1.0",
  "private": true,
  "description": "Helmet platform API (NestJS modular monolith)",
  "scripts": {
    "prebuild": "pnpm --filter @helmet/types build",
    "build": "nest build -p tsconfig.build.json",
    "predev": "pnpm --filter @helmet/types build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:once": "node dist/worker.js --once",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "typecheck": "pnpm --filter @helmet/types build && tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:migrate:create": "dotenv -e ../../.env -- prisma migrate dev --create-only",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@helmet/types": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "~6.19.0",
    "argon2": "^0.44.0",
    "bwip-js": "^4.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "libphonenumber-js": "^1.13.14",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.11.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@helmet/eslint-config": "workspace:*",
    "@helmet/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/bwip-js": "^3.2.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  }
}
