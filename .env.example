# ─────────────────────────────────────────────────────────────────────────────
# Helmet platform — environment template.
# Copy to `.env` for local development:  cp .env.example .env
# The values below are DEVELOPMENT-ONLY placeholders. The API refuses to start with
# NODE_ENV=production while any "dev-only" secret is still in use.
# Generate strong values with:  node scripts/generate-secrets.mjs
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Ports (docker-compose + dev servers) ─────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
ADMIN_PORT=3000
PORTAL_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=helmet
POSTGRES_PASSWORD=helmet-dev-only
POSTGRES_DB=helmet_platform
DATABASE_URL=postgresql://helmet:helmet-dev-only@localhost:5432/helmet_platform?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=helmet:

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Express "trust proxy" setting: false | true | number of hops | comma-separated subnets.
TRUST_PROXY=false
# When true, the client IP is read from CF-Connecting-IP (only enable behind Cloudflare).
TRUST_CLOUDFLARE=false
SWAGGER_ENABLED=true

# Base URL printed into QR codes: <PUBLIC_EMERGENCY_BASE_URL>/e/<token>
PUBLIC_EMERGENCY_BASE_URL=http://localhost:3001

# ── Admin auth ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=helmet-platform
ADMIN_REFRESH_TTL_DAYS=7
# Secure cookies require HTTPS; keep false only for local http development.
COOKIE_SECURE=false
COOKIE_DOMAIN=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# ── Cryptography ─────────────────────────────────────────────────────────────
# Pepper mixed into Argon2id activation-PIN hashes (>= 32 chars). Rotating it invalidates PINs.
PIN_HASH_PEPPER=dev-only-pin-pepper-change-me-0123456789abcdef
# AES-256-GCM keyrings: "<version>:<base64 32-byte key>[,<version>:<key>...]". First = active.
PIN_ESCROW_KEYS=v1:ZGV2LW9ubHktcGluLWVzY3Jvdy1rZXktMzJieXRlcyE=
DATA_ENCRYPTION_KEYS=v1:ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMiE=
# HMAC secret used to hash client IPs before storage (>= 32 chars).
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me-0123456789
PIN_ARGON2_MEMORY_KIB=19456
PIN_ARGON2_TIME_COST=2

# ── Customer auth ────────────────────────────────────────────────────────────
# Customers sign in with an owned Helmet ID + password. Recovery uses an offline code.
JWT_CUSTOMER_ACCESS_SECRET=dev-only-jwt-customer-secret-change-me-0123456789
JWT_CUSTOMER_ACCESS_TTL_SECONDS=900
CUSTOMER_REFRESH_TTL_DAYS=30
# Pepper for customer passwords and recovery codes (>= 32 chars). Rotating it invalidates them.
CUSTOMER_CREDENTIAL_PEPPER=dev-only-customer-pepper-change-me-0123456789
CUSTOMER_LOGIN_FAILURES_BEFORE_LOCK=5
CUSTOMER_LOGIN_LOCKOUT_BASE_SECONDS=60
CUSTOMER_LOGIN_LOCKOUT_MAX_SECONDS=3600
CUSTOMER_LOGIN_MAX_FAILURES_PER_IP_PER_HOUR=50
RECOVERY_FAILURES_BEFORE_LOCK=3
RECOVERY_LOCKOUT_BASE_SECONDS=900
RECOVERY_MAX_FAILURES_PER_IP_PER_HOUR=10
RECOVERY_RESET_TOKEN_TTL_SECONDS=600
# Phase 3: password re-check window for sensitive actions, and ownership transfer codes.
RECENT_AUTH_TTL_SECONDS=300
TRANSFER_TOKEN_TTL_MINUTES=30
TRANSFER_FAILURES_BEFORE_LOCK=5
TRANSFER_LOCKOUT_BASE_SECONDS=900
TRANSFER_MAX_FAILURES_PER_IP_PER_HOUR=20
# Phase 4: warranty policy and product reports.
WARRANTY_PURCHASE_DATE_TOLERANCE_DAYS=1
WARRANTY_REPLACEMENT_POLICY=INHERIT_END_DATE
WARRANTY_PROOF_MAX_BYTES=10485760
PRODUCT_REPORTS_PER_IP_PER_HOUR=5
# Region used to interpret phone numbers entered without a country code (contacts, optional mobile).
DEFAULT_PHONE_REGION=IN

# ── Activation ───────────────────────────────────────────────────────────────
# Customers can always activate SOLD helmets. Temporarily allow IN_INVENTORY helmets too:
ACTIVATION_ALLOW_IN_INVENTORY=false
ACTIVATION_FAILURES_BEFORE_LOCK=5
ACTIVATION_LOCKOUT_BASE_SECONDS=900
ACTIVATION_MAX_FAILURES_PER_CUSTOMER_PER_HOUR=10
ACTIVATION_MAX_FAILURES_PER_IP_PER_HOUR=20

# ── File storage (profile photos) ────────────────────────────────────────────
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=./storage
PROFILE_PHOTO_MAX_BYTES=5242880

# ── Public emergency page ────────────────────────────────────────────────────
PUBLIC_CACHE_TTL_SECONDS=30
SCAN_DEDUP_SECONDS=60
VITE_EMERGENCY_NUMBER=112

# ── Manufacturing ────────────────────────────────────────────────────────────
BATCH_MAX_QUANTITY=50000
BATCH_GENERATION_CHUNK_SIZE=500

# ── Rate limits (requests per window) ────────────────────────────────────────
THROTTLE_WINDOW_SECONDS=60
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_PUBLIC_LIMIT=120

# ── Seed (development only; never real credentials) ──────────────────────────
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe-Dev-Only-123!
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SAMPLE_HELMETS=50

# ── Frontends (Vite) ─────────────────────────────────────────────────────────
# Dev-server proxy target for /api. Browsers always call the relative /api path.
VITE_API_PROXY_TARGET=http://localhost:4000
