# /etc/helmet-platform/backup.env — read by scripts/backup.sh and scripts/restore.sh.
COMPOSE_DIR=/opt/helmet-platform
COMPOSE_ENV_FILE=/etc/helmet-platform/compose.env
DATA_ROOT=/srv/helmet-platform
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3
# REQUIRED before public launch: copy each backup off this server. $BACKUP_DIR is the new set.
# Examples (configure credentials outside this file):
#   BACKUP_OFFSITE_CMD='rclone copy "$BACKUP_DIR" offsite:helmet-backups/$(basename "$BACKUP_DIR")'
#   BACKUP_OFFSITE_CMD='rsync -a "$BACKUP_DIR" backup@backup-host:/backups/helmet/'
BACKUP_OFFSITE_CMD=
