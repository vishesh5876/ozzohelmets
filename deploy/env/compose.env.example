# /etc/helmet-platform/compose.env — non-secret Compose interpolation values.
#   docker compose -f docker-compose.prod.yml --env-file /etc/helmet-platform/compose.env …
COMPOSE_PROJECT_NAME=helmet
ADMIN_DOMAIN=admin.example.com
PORTAL_DOMAIN=safe.example.com
API_DOMAIN=api.example.com
# allow-all | cloudflare-only (closes connections whose TCP peer is not Cloudflare)
ORIGIN_ACCESS=allow-all
DATA_ROOT=/srv/helmet-platform
TLS_DIR=/etc/helmet-platform/tls
APP_ENV_FILE=/etc/helmet-platform/app.env
POSTGRES_ENV_FILE=/etc/helmet-platform/postgres.env
MONITORING_ENV_FILE=/etc/helmet-platform/monitoring.env
MONITORING_SECRETS_DIR=/etc/helmet-platform/monitoring
CLOUDFLARE_IPS_DIR=/etc/helmet-platform/nginx-cloudflare
EMERGENCY_NUMBER=112
IMAGE_PREFIX=helmet
API_REPLICAS=1
EDGE_SUBNET=172.30.0.0/24
# PostgreSQL sizing for a 4 GB VPS (see docs/VPS-DEPLOYMENT.md#postgresql-tuning)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
REDIS_MAXMEMORY=256mb
