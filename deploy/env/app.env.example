# /etc/helmet-platform/app.env — API + worker secrets and settings (mode 640, root:helmetdeploy).
# NEVER commit the real file. Generate every secret separately (one secret per function):
#   secrets (≥ 32 chars):     openssl rand -base64 48 | tr -d '\n='
#   AES-256 keys (32 bytes):  openssl rand -base64 32
# Back up this file (and especially the two keyrings) SEPARATELY from database backups:
# without DATA_ENCRYPTION_KEYS, encrypted medical fields in any backup are unrecoverable.
NODE_ENV=production
LOG_LEVEL=info

# ── Datastores (private Docker network; see postgres.env for the matching password) ──
DATABASE_URL=postgresql://helmet:CHANGE_ME_DB_PASSWORD@postgres:5432/helmet_platform?schema=public&connection_limit=10&pool_timeout=10
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=helmet:

# ── Public URLs (the QR base URL is PRINTED ON LABELS — choose it once) ──
PUBLIC_EMERGENCY_BASE_URL=https://safe.example.com
CORS_ORIGINS=https://admin.example.com,https://safe.example.com
COOKIE_SECURE=true
SWAGGER_ENABLED=false

# ── Auth secrets (all different) ──
JWT_ACCESS_SECRET=CHANGE_ME
JWT_CUSTOMER_ACCESS_SECRET=CHANGE_ME
CUSTOMER_CREDENTIAL_PEPPER=CHANGE_ME
PIN_HASH_PEPPER=CHANGE_ME
IP_HASH_SECRET=CHANGE_ME

# ── Encryption keyrings: "<version>:<base64 32-byte key>", first entry encrypts, all decrypt.
# Rotation: prepend a new version, deploy, run `node dist/cli.js encryption:rotate --keyring data`,
# keep the old version until `encryption:status` shows no ciphertext uses it.
DATA_ENCRYPTION_KEYS=v1:CHANGE_ME_BASE64_32_BYTES
PIN_ESCROW_KEYS=v1:CHANGE_ME_BASE64_32_BYTES

# ── Monitoring: Prometheus scrape token (also in /etc/helmet-platform/monitoring/metrics_token) ──
METRICS_TOKEN=CHANGE_ME

# ── Uploads: local VPS filesystem (bind mount /srv/helmet-platform/uploads → /app/storage) ──
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=/app/storage
# Optional ClamAV (compose profile "clamav"); recommended true for public production.
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── Rate limits (production defaults; the public emergency page is never login-throttled) ──
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_PUBLIC_LIMIT=300
PUBLIC_MISS_LIMIT_PER_IP=30
PUBLIC_UNCACHED_LIMIT_WHEN_FLAGGED=10
PRODUCT_REPORTS_PER_IP_PER_HOUR=5

# ── Retention ──
SCAN_DETAIL_RETENTION_DAYS=180
SECURITY_EVENT_RETENTION_DAYS=365
