# Edge reverse proxy (IPv4 inside Docker; the host forwards IPv6 on the published ports).
# Rendered at container start by envsubst:
#   ${ADMIN_DOMAIN} ${PORTAL_DOMAIN} ${API_DOMAIN} ${ORIGIN_ACCESS}
include /etc/nginx/cloudflare/realip.conf;
include /etc/nginx/cloudflare/geo.conf;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Access logs: no client IP (raw IPs are never persisted), no query strings, QR tokens masked.
map $uri $log_uri {
  ~^(?<p>/e/|/verify/|/api/v1/public/emergency/|/api/v1/public/verify/)[A-Za-z0-9_-]+(?<rest>.*)$ $p:token$rest;
  default $uri;
}
log_format edge_json escape=json '{"time":"$time_iso8601","host":"$host","method":"$request_method",'
  '"uri":"$log_uri","status":$status,"bytes":$body_bytes_sent,"rt":$request_time,'
  '"urt":"$upstream_response_time","req_id":"$request_id","cf_ray":"$http_cf_ray"}';
access_log /dev/stdout edge_json;

# Coarse flood protection per verified client IP (the API enforces the fine-grained limits).
# Generous bursts: a crash scene or a shared/CGNAT network must not be locked out of /e/ pages.
limit_req_zone $binary_remote_addr zone=edge_api:20m rate=30r/s;
limit_req_zone $binary_remote_addr zone=edge_pages:20m rate=60r/s;
limit_conn_zone $binary_remote_addr zone=edge_conn:20m;
limit_req_status 429;
limit_conn_status 429;

client_max_body_size 12m;
client_body_timeout 30s;
client_header_timeout 15s;
send_timeout 30s;
server_tokens off;

gzip on;
gzip_comp_level 5;
gzip_min_length 512;
gzip_proxied any;
gzip_vary on;
gzip_types application/json application/javascript text/css text/plain image/svg+xml;

# Docker DNS, re-resolved every 10 s: a redeployed container (new IP) is picked up without
# restarting the edge, and API replicas are balanced round-robin.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream helmet_api    { zone helmet_api 64k;    server api:4000 resolve;    keepalive 16; }
upstream helmet_admin  { zone helmet_admin 64k;  server admin:8080 resolve;  keepalive 8; }
upstream helmet_portal { zone helmet_portal 64k; server portal:8080 resolve; keepalive 8; }

# ── :80 — redirect to HTTPS; local health probe for the container healthcheck ──
server {
  listen 80 default_server;
  server_name _;
  location = /__edge_health { access_log off; allow 127.0.0.1; deny all; return 200 "ok\n"; }
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

# ── Unknown host / direct IP access over TLS: close without a response ──
server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;
  include /etc/nginx/snippets/tls.conf;
  return 444;
}

# ── Customer portal + public QR pages ──
server {
  listen 443 ssl;
  http2 on;
  server_name ${PORTAL_DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/origin-${ORIGIN_ACCESS}.conf;
  include /etc/nginx/snippets/edge-headers.conf;
  limit_conn edge_conn 100;

  location /api/v1/internal/ { return 404; }
  location /api/ {
    limit_req zone=edge_api burst=200 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_buffering off;
    proxy_pass http://helmet_portal;
  }
  location / {
    limit_req zone=edge_pages burst=300 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://helmet_portal;
  }
}

# ── Admin console ──
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/origin-${ORIGIN_ACCESS}.conf;
  include /etc/nginx/snippets/edge-headers.conf;
  limit_conn edge_conn 50;

  location /api/v1/internal/ { return 404; }
  location /api/ {
    limit_req zone=edge_api burst=100 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_buffering off;
    proxy_pass http://helmet_admin;
  }
  location / {
    limit_req zone=edge_pages burst=200 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://helmet_admin;
  }
}

# ── Direct API host (optional; the SPAs use same-origin /api) ──
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/origin-${ORIGIN_ACCESS}.conf;
  include /etc/nginx/snippets/edge-headers.conf;
  limit_conn edge_conn 100;

  location /api/v1/internal/ { return 404; }
  location / {
    limit_req zone=edge_api burst=200 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_buffering off;
    proxy_pass http://helmet_api;
  }
}
