# SPA container (admin or portal), behind the edge proxy. Rendered by the nginx image's envsubst
# templating: ${API_HOST_PORT}, ${CSP_POLICY}. Runs unprivileged on :8080.

# Keep the scheme the edge saw (TLS terminates there).
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

# Re-resolve the API through Docker DNS so a redeployed API container (new IP) is found.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream helmet_api_upstream { zone helmet_api_upstream 64k; server ${API_HOST_PORT} resolve; keepalive 8; }

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  autoindex off;
  charset utf-8;

  # Uploads go through here to the API: profile photos ≤ 5 MB, warranty proofs ≤ 10 MB.
  client_max_body_size 12m;
  client_body_timeout 30s;
  send_timeout 30s;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 512;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Same-origin API access keeps the refresh cookie SameSite=Strict-compatible.
  location /api/ {
    # Monitoring endpoints are internal-only.
    location /api/v1/internal/ { return 404; }
    proxy_pass http://helmet_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade_spa;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_send_timeout 60s;
    proxy_buffering off;  # stream CSV exports
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "${CSP_POLICY}" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Public emergency + verification pages: standalone lightweight entry with a very strict CSP
  # (no inline code, no third parties; photo and API from this origin only).
  location ~ ^/(e|verify)/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-cache";
    try_files /emergency.html /index.html;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "${CSP_POLICY}" always;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}

map $http_upgrade $connection_upgrade_spa {
  default upgrade;
  ''      '';
}
